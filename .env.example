# PIHUB root environment template (copy to .env and fill in secrets)
# NOTE: .env is gitignored. Never commit real secrets.

# --- Core service URLs (compose network) ---
CONTENT_PIPELINE_URL=http://content-pipeline:8001
INFERENCE_SERVICE_URL=http://inference-service:8010
PIHUB_URL=http://pihub:8020
PACK_SERVICE_URL=http://pack-service:8030
EXPERIMENT_SERVICE_URL=http://experiment-service:8040
VOICE_SERVICE_URL=http://voice-service:8050
QDRANT_URL=http://qdrant:6333
MONGO_URL=mongodb://mongo:27017
COBALT_API_URL=http://cobalt:9000

# --- Embeddings (multilingual by default so Kannada + English share one space) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/shared/models/sentence-transformers/embedding
LOCAL_RETRIEVAL_MODEL_NAME=BAAI/bge-m3
LOCAL_RETRIEVAL_DEVICE=cpu
LOCAL_RETRIEVAL_CACHE_DIR=/shared/models/sentence-transformers/retrieval

# --- Enrichment ---
ENRICHMENT_LANGUAGES=en,kn
ENRICHMENT_COLLECTION=enrichment_resources
MEDIA_STORAGE_PATH=/shared/media
MEDIA_MAX_TOTAL_GB=20

# --- Qdrant auth (set in production; leave blank for trusted LAN) ---
# QDRANT__SERVICE__API_KEY=

# --- Mongo auth (set in production) ---
# MONGO_INITDB_ROOT_USERNAME=
# MONGO_INITDB_ROOT_PASSWORD=

# --- LLM serving ---
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_MODEL_PATH=/models/model.gguf
LLAMA_CONTEXT_SIZE=2048
CONTENT_GENERATION_BACKEND=ollama
GEMMA_CONTENT_MODEL=gemma4

# --- Classroom node auth (CHANGE THESE) ---
PIHUB_ADMIN_TOKEN=change-me
PIHUB_DEVICE_TOKEN_SECRET=change-me-too
PIHUB_CLASSROOM_NAME=Classroom A

# --- Paths / misc ---
UPLOAD_DIR=/shared/uploads
WORK_DIR=/shared/work
NGINX_PORT=80
LOG_LEVEL=INFO
